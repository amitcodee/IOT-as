// Copy this file to "secrets.h" (same folder) and fill in your own values.
// secrets.h is git-ignored, so your WiFi password is never committed.
//
// The chip needs ONLY this: WiFi + the Firebase project it reports to. There is no email or
// password for Firebase - the reader signs in anonymously and a Super Admin approves it in the
// web dashboard (Devices). Turn on "Anonymous" once in Firebase console > Authentication >
// Sign-in method.

// --- WiFi ---
#define MY_WIFI_SSID       "YOUR_WIFI_NAME"
#define MY_WIFI_PASS       "YOUR_WIFI_PASSWORD"

// --- Firebase project (same values as FIREBASE_API_KEY / FIREBASE_PROJECT_ID in web/.env).
//     The API key is a public identifier, not a password. ---
#define MY_API_KEY         "YOUR_FIREBASE_WEB_API_KEY"
#define MY_PROJECT_ID      "your-firebase-project-id"

// --- Name shown in the dashboard's Devices list (max 40 characters, no quotes or backslashes) ---
#define MY_DEVICE_NAME     "Main Gate"

// --- Timezone in seconds from UTC: India=19800 Dubai=14400 London=0 Singapore=28800 ---
#define MY_GMT_OFFSET      19800
